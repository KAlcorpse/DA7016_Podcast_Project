# Copy this file to .env and fill it in. NEVER commit .env or put keys in frontend code.
# Bodhan issues a separate key per model, so the LLM and TTS keys are separate.

# --- Script-writing LLM (any OpenAI-compatible chat endpoint) ---
# Bodhan's public release has no general chat LLM (its models are OCR, Translate,
# Transcribe, Speak), so confirm with your lab which chat model/endpoint to use.
LLM_BASE_URL=https://<your-lab-llm-host>/v1
LLM_API_KEY=
LLM_MODEL=

# --- Bodhan Indic-Speak TTS ---
BODHAN_TTS_BASE_URL=https://api.bodhan.ai/v1
BODHAN_TTS_KEY=
BODHAN_TTS_MODEL=indic-speak
# Two different voices for the two hosts (pick from the voice list in the Bodhan console)
BODHAN_VOICE_A=
BODHAN_VOICE_B=
# The speech API requires a language setting; use the code format from the console docs
PODCAST_TTS_LANGUAGE=en

# --- Episode settings ---
PODCAST_SCRIPT_LANGUAGE=English
HOST_A_NAME=Meera
HOST_B_NAME=Arjun
# Bodhan recommends short TTS inputs, so long lines are split before synthesis
TTS_MAX_CHARS=250
# Parallel TTS requests; keep low so you don't hammer the lab's quota
TTS_WORKERS=3
